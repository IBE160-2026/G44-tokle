# Copy this file to .env and change what you need. .env is never committed.
# Priority: a command-line flag wins over .env, and .env wins over the default.

# Port the app serves on, at http://127.0.0.1:<PORT> (default 8044).
PORT=8044

# Random Seed for the Skill Test; the same Seed and data always give the same result (default 44).
SEED=44

# Most requests per second sent to Polymarket. 5 is the highest allowed (default 5).
POLYMARKET_REQUESTS_PER_SECOND=5

# Offline Mode: true uses only the Sample Dataset and never goes online (default false).
OFFLINE=false

# Key for the language model (stage 3, optional). Leave empty to use template text instead.
ANTHROPIC_API_KEY=
